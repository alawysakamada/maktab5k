ngth\"\n        )\n        labels = self.tokenizer(\n            answer,\n            return_tensors=\"pt\",\n            truncation=True,\n            max_length=self.max_length,\n            padding=\"max_length\"\n        ).input_ids\n\n        return {\n            'input_ids': inputs['input_ids'].squeeze(),\n            'attention_mask': inputs['attention_mask'].squeeze(),\n            'labels': labels.squeeze()\n        }\n\n# Fungsi memuat dan membagi dataset\ndef load_and_split_data(csv_file):\n    df = pd.read_csv(csv_file)\n    # Filter data hanya yang bukan NaN atau kosong\n    df = df[df['content'].notna() & df['content'].astype(str).str.strip().ne('')]\n    train_data, val_data = train_test_split(df, test_size=0.2)\n    return train_data.reset_index(drop=True), val_data.reset_index(drop=True)\n\n# Fungsi untuk menghasilkan pertanyaan\ndef generate_questions(model, tokenizer, context, max_length=50):\n    if isinstance(context, str):  # Pastikan context adalah string\n        inputs = tokenizer(context, return_tensors=\"pt\", truncation=True, max_length=512).input_ids.to(model.device)\n        outputs = model.generate(inputs, max_length=max_length)\n        question = tokenizer.decode(outputs[0], skip_special_tokens=True)\n        return question\n    return \"\"\n\ndef fine_tune_model(train_dataset, val_dataset, output_dir=\"model\", epochs=5, batch_size=2):\n    checkpoint_dir = os.path.join(output_dir, \"checkpoint\")\n    if os.path.exists(checkpoint_dir):\n        latest_checkpoint = max([os.path.join(checkpoint_dir, d) for d in os.listdir(checkpoint_dir)], key=os.path.getctime)\n        print(f\"Loading model from checkpoint: {latest_checkpoint}\")\n        question_model.from_pretrained(latest_checkpoint)\n\n    training_args = Seq2SeqTrainingArguments(\n        output_dir=output_dir,\n        per_device_train_batch_size=batch_size,\n        per_device_eval_batch_size=batch_size,\n        predict_with_generate=True,\n        evaluation_strategy=\"