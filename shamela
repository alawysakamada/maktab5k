oad\nfrom sklearn.model_selection import train_test_split\nimport wandb\n\n# Login ke W&B menggunakan API key\nwandb.login(key=\"5a646a4e2997f8ff868dfe4df325accd8a13b4b6\")\n\n# Inisialisasi Tokenizer dan Model untuk pertanyaan\nquestion_model_name = \"MIIB-NLP/Arabic-question-generation\"\nquestion_tokenizer = AutoTokenizer.from_pretrained(question_model_name)\nquestion_model = AutoModelForSeq2SeqLM.from_pretrained(question_model_name)\n\n# Inisialisasi Tokenizer dan Model untuk ringkasan\nsummary_model_name = \"facebook/bart-large-cnn\"\nsummary_tokenizer = AutoTokenizer.from_pretrained(summary_model_name)\nsummary_model = AutoModelForSeq2SeqLM.from_pretrained(summary_model_name)\n\nclass ArabicQuestionAnswerDataset(Dataset):\n    def __init__(self, data, question_tokenizer, summary_tokenizer, max_length=256):\n        self.question_tokenizer = question_tokenizer\n        self.summary_tokenizer = summary_tokenizer\n        self.data = data\n        self.max_length = max_length\n\n    def __len__(self):\n        return len(self.data)\n\n    def __getitem__(self, idx):\n        context = self.data.loc[idx, 'content']\n\n        if not isinstance(context, str):\n            context = \"Default context text\"\n\n        question = self.generate_question(context)\n        answer = self.generate_summary(context)\n\n        question_inputs = self.question_tokenizer(\n            question,\n            return_tensors=\"pt\",\n            truncation=True,\n            max_length=self.max_length,\n            padding=\"max_length\"\n        )\n        answer_labels = self.summary_tokenizer(\n            answer,\n            return_tensors=\"pt\",\n            truncation=True,\n            max_length=self.max_length,\n            padding=\"max_length\"\n        ).input_ids\n\n        return {\n            'input_ids': question_inputs['input_ids'].squeeze(),\n            'attention_mask': question_inputs['attention_mask'].squeeze(),\n            'labels': answer_labels.squeeze()\n        }\n\n    def generate_question(self, context):\n        inputs = self.question_tokenizer(context, return_tensors=\"pt\", truncation=True, max_length=256).input_ids.to(question_model.device)\n        outputs = question_model.generate(inputs, max_length=50)\n        question = self.question_tokenizer.decode(outputs[0], skip_special_tokens=True)\n        return question\n\n    def generate_summary(self, context):\n        inputs = self.summary_tokenizer(context, return_tensors=\"pt\", truncation=True, max_length=256).input_ids.to(summary_model.device)\n        outputs = summary_model.generate(inputs, max_length=100)\n        summary = self.summary_tokenizer.decode(outputs[0], skip_special_tokens=True)\n        return summary\n\ndef load_and_split_data(csv_file):\n    df = pd.read_csv(csv_file)\n    train_data, val_data = train_test_split(df, test_size=0.2)\n    return train_data.reset_index(drop=True), val_data.reset_index(drop=True)\n\ndef fine_tune_model(train_dataset, val_dataset, output_dir=\"model\", epochs=3, batch_size=1):\n    # Check for existing checkpoints\n    checkpoint_dir = os.path.join(output_dir, \"checkpoint\")\n    if os.path.exists(checkpoint_dir):\n        latest_checkpoint = max([os.path.join(checkpoint_dir, d) for d in os.listdir(checkpoint_dir)], key=os.path.getctime)\n        print(f\"Loading model from checkpoint: {latest_checkpoint}\")\n        question_model.from_pretrained(latest_checkpoint)\n\n    training_args = Seq2SeqTrainingArguments(\n        output_dir=output_dir,\n        per_device_train_batch_size=batch_size,\n        per_device_eval_batch_size=batch_size,\n        predict_with_generate=True,\n        evaluation_strategy=\"steps\",\n        save_steps=500,  # Save every 500 steps\n        eval_steps=500,\n        logging_dir='./logs',\n        logging_steps=100,\n        num_train_epochs=epochs,\n        save_total_limit=2,\n        load_best_model_at_end=True,\n        gradient_accumulation_steps=2,\n        report_to=\"wandb\",  # Log to Weights & Biases\n    )\n\n    trainer = Seq2SeqTrainer(\n        model=question_model,\n        args=training_args,\n        train_dataset=train_dataset,\n        eval_dataset=val_dataset,\n    )\n\n    # Mulai proses pelatihan\n    trainer.train()\n\n    # Simpan model dan tokenizer setelah pelatihan\n    question_model.save_pretrained(output_dir)\n    question_tokenizer.save_pretrained(output_dir)\n    print(f\"Model dan tokenizer disimpan di: {output_dir}\")\n\ndef main(csv_file):\n    # Load dan bagi dataset\n    train_data, val_data = load_and_split_data(csv_file)\n\n    # Siapkan dataset untuk fine-tuning\n    train_dataset = ArabicQuestionAnswerDataset(train_data, question_tokenizer, summary_tokenizer)\n    val_dataset = ArabicQuestionAnswerDataset(val_data, question_tokenizer, summary_tokenizer)\n\n    # Fine-tune model\n    fine_tune_model(train_dataset, val_dataset)\n\n    # Hasilkan pertanyaan dan jawaban serta simpan ke CSV\n    df = pd.read_csv(csv_file)\n    df['Generated_Question'] = df['content'].apply(lambda x: question_model.generate(question_tokenizer(x, return_tensors=\"pt\", truncation=True, max_length=256).input_ids.to(question_model.device)))\n    df['Generated_Answer'] = df['content'].apply(lambda x: summary_model.generate(summary_tokenizer(x, return_tensors=\"pt\", truncation=True, max_length=256).input_ids.to(summary_model.device)))\n\n    # Simpan ke file CSV baru\n    output_csv = \"fathulQoribQA.csv\"\n    df.to_csv(output_csv, index=False)\n    print(f\"Hasil pertanyaan dan jawaban disimpan di: {output_csv}\")\n\nif __name__ == \"__main__\":\n    # Ganti dengan path dataset CSV Anda\n    csv_file = \"/kaggle/input/fathul-qorib/fathulQorib.csv\"\n    main(csv_file)\n","metadata":{"trusted":true},"execution_count":null,"outputs":[]},{"cell_type":"code","source":"import shutil\n\n# Misalnya 'output_dir' adalah direktori yang ingin disimpan\nshutil.make_archive('model', 'zip', '/kaggle/working/')\n\n# Upload ZIP ke G